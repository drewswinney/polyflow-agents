{
  "name": "hermes-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A cross-platform (iOS + Android) mobile client for a [Hermes](https://github.com/) agent, built so the agent harness behind it can be swapped later.",
  "homepage": "https://github.com/drewswinney/polyflow-agents#readme",
  "bugs": {
    "url": "https://github.com/drewswinney/polyflow-agents/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drewswinney/polyflow-agents.git"
  },
  "license": "MIT",
  "author": "Drew Swinney",
  "main": "expo-router/entry",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "expo lint",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:related": "jest --findRelatedTests",
    "sync:upstream": "./scripts/sync-upstream.sh",
    "spike:m0": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/m0-spike.mts",
    "check:m0": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/m0-offline-check.mts",
    "check:images": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/node-resolve.mjs scripts/images-offline-check.mts",
    "check:discovery": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/node-resolve.mjs scripts/discovery-offline-check.mts",
    "check:plugin": "python3 scripts/plugin-api-check.py"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "~0.4.2",
    "@expo-google-fonts/outfit": "~0.4.2",
    "@expo-google-fonts/space-mono": "~0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "~5.102.8",
    "expo": "~57.0.18",
    "expo-asset": "~57.0.15",
    "expo-audio": "~57.0.4",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.2",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.19",
    "js-sha256": "^1.0.0",
    "markdown-it": "^15.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "~2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "~5.0.8"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "~30.0.0",
    "@types/node": "^26.4.0",
    "@types/react": "~19.1.0",
    "eslint": "^10.9.1",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-jest": "^29.16.6",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^17.4.1",
    "react-test-renderer": "19.2.8",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~7.0.2"
  }
}
