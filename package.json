{
  "name": "hermes-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A cross-platform (iOS + Android) mobile client for a [Hermes](https://github.com/) agent, built so the agent harness behind it can be swapped later.",
  "homepage": "https://github.com/drewswinney/agent-handheld#readme",
  "bugs": {
    "url": "https://github.com/drewswinney/agent-handheld/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drewswinney/agent-handheld.git"
  },
  "license": "ISC",
  "author": "",
  "main": "expo-router/entry",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "expo lint",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:related": "jest --findRelatedTests",
    "sync:upstream": "./scripts/sync-upstream.sh",
    "spike:m0": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/m0-spike.mts",
    "check:m0": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/m0-offline-check.mts",
    "check:images": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/node-resolve.mjs scripts/images-offline-check.mts",
    "check:discovery": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/node-resolve.mjs scripts/discovery-offline-check.mts",
    "check:plugin": "python3 scripts/plugin-api-check.py"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "~0.4.2",
    "@expo-google-fonts/outfit": "~0.4.2",
    "@expo-google-fonts/space-mono": "~0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "~5.90.2",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "js-sha256": "^1.0.0",
    "markdown-it": "^15.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "~2.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "~5.0.8"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "~29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-jest": "^29.16.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "lint-staged": "^17.3.0",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  }
}
