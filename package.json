    "@expo/vector-icons": "~15.0.2",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "~5.90.2",
    "expo": "~57.0.14",
    "expo-blur": "~57.0.1",
    "expo-constants": "~57.0.12",
